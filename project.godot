; Engine configuration file.
; Godot 4 project

config_version=5

[application]
config/name="Last Line"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
retreat={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
rally={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
restart={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194309)]}
